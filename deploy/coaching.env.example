# The Acer server's settings. deploy/setup.sh copies this to deploy/coaching.env
# (never committed) and fills in the secrets. Every service reads that file.

# --- secrets (setup.sh generates these) -----------------------------------
# Shared by the app and the worker. 32+ random characters.
IMPORT_TOKEN=
# Asked for on the first-run page that creates the head coach account.
SETUP_TOKEN=

# --- the web app ------------------------------------------------------------
NODE_ENV=production
PORT=3000
# The address coaches open (Tailscale: <machine>.<tailnet>.ts.net), so forms
# posted through the proxy are accepted. Comma-separated if more than one.
APP_HOSTS=
# Where the data lives. Defaults: web/data/app.db and web/data/media.
# Point APP_MEDIA at a bigger drive if there is one, e.g. /mnt/video/media.
#APP_DB=
#APP_MEDIA=
# Largest upload accepted, in GB.
MAX_UPLOAD_GB=20

# --- the worker -------------------------------------------------------------
APP_URL=http://127.0.0.1:3000
# Qwen through Ollama. qwen3:4b fits the RTX 2050's 4GB; qwen3:8b also runs
# but spills onto the processor and takes several minutes.
FEEDBACK_BACKEND=ollama
FEEDBACK_MODEL=qwen3:4b

# --- nightly upkeep (deploy/backup.sh) --------------------------------------
# A different drive from the data, ideally: a backup on the same disk dies
# with it. Leave empty for no backups (not recommended).
BACKUP_DIR=
BACKUP_KEEP=14
# Delete session videos this many days after they arrive (the report stays).
# Empty keeps them. Agree this with the school.
VIDEO_RETENTION_DAYS=120
FAILED_UPLOAD_DAYS=14
