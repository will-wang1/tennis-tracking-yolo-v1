# Copy to .env and fill in for local/docker-compose use. In docker-compose,
# DATABASE_URL/REDIS_URL/S3_ENDPOINT_URL are already set to point at the
# compose services (see docker-compose.yml) - you mainly need to set the
# secrets and model weight paths below.

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=10080

# --- Database (overridden in docker-compose.yml to point at the postgres service) ---
DATABASE_URL=postgresql+psycopg2://tennis:tennis@localhost:5432/tennis

# --- Redis / Celery (overridden in docker-compose.yml) ---
REDIS_URL=redis://localhost:6379/0

# --- S3-compatible storage (overridden in docker-compose.yml to point at minio) ---
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tennis-tracking
S3_REGION=us-east-1

# --- ML pipeline weights (REQUIRED for the worker to do anything - see
# README "Deployment" - these files do not ship in this repo) ---
# One of: yolo | tracknet | wasb - must match whichever checkpoint you have.
DETECTOR_BACKEND=wasb
BALL_WEIGHTS_PATH=/app/weights/ball_detector.pt
WASB_WEIGHTS_PATH=/app/weights/wasb_tennis_pretrained.pth.tar
TRACKNET_WEIGHTS_PATH=/app/weights/tracknet_pretrained.pt
BOUNCE_WEIGHTS_PATH=/app/weights/bounce_catboost_pretrained.cbm
# Optional - leave unset to disable the minimap/court-overlay toggle in the UI
COURT_WEIGHTS_PATH=
# e.g. "cuda:0" on a GPU worker; leave unset for CPU/each model's own default
PIPELINE_DEVICE=

# --- Worker build (backend/Dockerfile.worker build arg, not read at runtime) ---
# Set this on a machine with no NVIDIA GPU (e.g. a Mac) to install a
# CPU-only torch/torchvision instead of the default CUDA-enabled build -
# smaller/faster to pull, and works around a native-library segfault seen
# combining torch+tensorflow+opencv with the default GPU wheels on some
# platforms. Leave unset on a real GPU machine (the RTX 2050 laptop, a
# friend's rig) to keep CUDA support.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# --- Misc ---
MAX_UPLOAD_BYTES=2147483648
CORS_ORIGINS=["http://localhost:5173"]
