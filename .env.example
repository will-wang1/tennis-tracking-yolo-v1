# Copy to .env and fill in for local/docker-compose use. In docker-compose,
# DATABASE_URL/REDIS_URL/S3_ENDPOINT_URL are already set to point at the
# compose services (see docker-compose.yml) - you mainly need to set the
# secrets and model weight paths below.

# --- Auth ---
# Generate real values before this server is reachable by anyone but you,
# e.g.:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=10080
# Require this code in the registration form to keep signups closed to
# people you've shared it with. Leave commented out/unset for open
# registration (fine for solo local dev, NOT fine once this is reachable
# by anyone else). Also generate this one, e.g.: openssl rand -hex 8
# INVITE_CODE=change-me-to-a-shared-secret

# --- Database ---
# These three are read directly by docker-compose.yml for the postgres
# container itself, so changing them here rotates the real DB password too
# (not just what the app sends) - no separate place to update.
POSTGRES_USER=tennis
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=tennis
# Only used outside docker-compose (e.g. running the API directly against a
# non-compose Postgres) - compose builds its own DATABASE_URL from the
# POSTGRES_* vars above so the app and the DB container never drift apart.
DATABASE_URL=postgresql+psycopg2://tennis:tennis@localhost:5432/tennis

# --- Redis / Celery (overridden in docker-compose.yml) ---
REDIS_URL=redis://localhost:6379/0

# --- S3-compatible storage ---
# S3_ACCESS_KEY/S3_SECRET_KEY double as MinIO's root user/password in
# docker-compose.yml, so rotating them here rotates the real MinIO
# credentials too.
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-to-a-long-random-string
S3_BUCKET=tennis-tracking
S3_REGION=us-east-1

# --- ML pipeline weights (REQUIRED for the worker to do anything - see
# README "Deployment" - these files do not ship in this repo) ---
# One of: yolo | tracknet | wasb - must match whichever checkpoint you have.
DETECTOR_BACKEND=wasb
BALL_WEIGHTS_PATH=/app/weights/ball_detector.pt
WASB_WEIGHTS_PATH=/app/weights/wasb_tennis_pretrained.pth.tar
TRACKNET_WEIGHTS_PATH=/app/weights/tracknet_pretrained.pt
BOUNCE_WEIGHTS_PATH=/app/weights/bounce_catboost_pretrained.cbm
# Optional - leave commented out to disable the minimap/court-overlay toggle
# in the UI. Note "unset" means commented out, NOT `COURT_WEIGHTS_PATH=` with
# an empty value - a written-but-empty var is read as "" rather than unset.
# COURT_WEIGHTS_PATH=/app/weights/court_net_pretrained.pt
# e.g. "cuda:0" on a GPU worker; leave commented out (not blank - see above)
# for CPU/each model's own default.
# PIPELINE_DEVICE=cuda:0

# --- Worker build (backend/Dockerfile.worker build arg, not read at runtime) ---
# Set this on a machine with no NVIDIA GPU (e.g. a Mac) to install a
# CPU-only torch/torchvision instead of the default CUDA-enabled build -
# smaller/faster to pull, and works around a native-library segfault seen
# combining torch+tensorflow+opencv with the default GPU wheels on some
# platforms. Leave unset on a real GPU machine (the RTX 2050 laptop, a
# friend's rig) to keep CUDA support.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# --- Misc ---
MAX_UPLOAD_BYTES=2147483648
# Update this once the site has a real domain (e.g. "https://tennis.example.com") -
# the browser will reject cross-origin API calls otherwise.
CORS_ORIGINS=["http://localhost:5173"]

# --- Public access over Tailscale (optional) ---
# Only needed if you're running the `tailscale` service (see
# docker-compose.yml / README "Public access over Tailscale"). Generate a
# key at https://login.tailscale.com/admin/settings/keys - a reusable,
# non-ephemeral key is easiest if you'll be restarting the container.
# TS_AUTHKEY=tskey-auth-...
